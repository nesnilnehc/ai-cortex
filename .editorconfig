root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# In markdown a double space at end of line means a line break, so keep it
trim_trailing_whitespace = false

[*.sh]
indent_size = 2

[Makefile]
indent_style = tab
